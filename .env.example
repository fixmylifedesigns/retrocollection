# Where your ROMs live: "drive", "s3" (Cloudflare R2, Backblaze B2, Wasabi…) or "none"
STORAGE_PROVIDER=none

# --- Google Drive -----------------------------------------------------------
# API key from Google Cloud Console with the Drive API enabled.
# Each folder must be shared as "Anyone with the link can view".
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_FOLDER_GB=
GOOGLE_DRIVE_FOLDER_GBA=
GOOGLE_DRIVE_FOLDER_PS2=

# --- S3-compatible bucket (R2 / B2 / Wasabi) --------------------------------
# R2:  https://<account-id>.r2.cloudflarestorage.com   region: auto
# B2:  https://s3.<region>.backblazeb2.com              region: e.g. us-west-004
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Folder layout inside the bucket: <prefix>gb/, <prefix>gba/, <prefix>ps2/
S3_PREFIX=roms/
# Optional: public or custom-domain URL for the bucket. When set, ROMs are
# served from here directly instead of through short-lived signed links.
S3_PUBLIC_BASE_URL=
