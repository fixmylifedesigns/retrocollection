{
  "name": "retrocollection",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/fetch-ps2-engine.mjs",
    "dev": "next dev",
    "dev:https": "node scripts/fetch-ps2-engine.mjs && next dev --experimental-https -H 0.0.0.0",
    "prebuild": "node scripts/fetch-ps2-engine.mjs",
    "build": "next build",
    "ps2:fetch": "node scripts/fetch-ps2-engine.mjs --force",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "aws4fetch": "^1.0.20",
    "next": "16.3.5",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
